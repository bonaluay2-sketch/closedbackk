NODE_ENV=production
GAME_ENV=prod
NUM_WORKERS=1

# Force the master and worker boundaries to Hugging Face requirements
PORT=7860
BACKEND_PORT=7860

# Provide structurally valid loopback URLs (No raw IP subdomains like api.127.0.0.1)
DOMAIN=localhost:7860
BACKEND_URL=http://localhost:7860
LOBBY_SERVER_URL=http://localhost:7860
API_URL=http://localhost:7860

# Provide the required dummy keys so the HTML compiler doesn't crash
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
